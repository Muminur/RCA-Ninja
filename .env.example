# Anthropic API key (OPTIONAL — only needed if you want --bare mode)
# RCA generation works with your Claude.ai OAuth login by default.
# Only set this if you have a separate API key from console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-api-your-key-here

# Obsidian Local REST API configuration (OPTIONAL — for vault sync)
# Get your API key from Obsidian → Settings → Local REST API
OBSIDIAN_API_KEY=your-obsidian-api-key-here
OBSIDIAN_HOST=127.0.0.1
OBSIDIAN_PORT=27124
