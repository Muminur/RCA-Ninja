{
  "name": "claude-rca",
  "version": "0.1.0",
  "description": "Local-first CLI that turns bug-fix commits into structured Root Cause Analysis Markdown artifacts",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "claude-rca": "./bin/claude-rca"
  },
  "scripts": {
    "test": "node --test \"test/unit/**/*.test.mjs\"",
    "test:unit": "node --test \"test/unit/**/*.test.mjs\"",
    "test:integration": "node --test \"test/integration/**/*.test.mjs\"",
    "test:e2e": "node --test \"test/e2e/**/*.test.mjs\"",
    "test:watch": "node --test --watch \"test/unit/**/*.test.mjs\"",
    "lint": "eslint \"src/**/*.mjs\" \"test/**/*.mjs\" bin/claude-rca && prettier --check \"**/*.{mjs,json,md}\"",
    "format": "prettier --write \"**/*.{mjs,json,md}\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "coverage": "c8 --include \"src/**/*.mjs\" --exclude \"src/mcp-server.mjs\" --reporter text --reporter html node --test \"test/unit/**/*.test.mjs\" \"test/integration/**/*.test.mjs\"",
    "check": "npm run lint && npm run typecheck && c8 --include \"src/**/*.mjs\" --exclude \"src/mcp-server.mjs\" --check-coverage --lines 85 node --test \"test/unit/**/*.test.mjs\" \"test/integration/**/*.test.mjs\" \"test/e2e/**/*.test.mjs\"",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "rca",
    "root-cause-analysis",
    "claude",
    "postmortem",
    "obsidian"
  ],
  "license": "MIT",
  "files": [
    "bin/",
    "src/",
    "prompts/"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^11.0.0",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
