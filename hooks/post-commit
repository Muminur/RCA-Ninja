#!/usr/bin/env bash
# claude-rca post-commit hook — generates an RCA when the commit
# message starts with "fix:" (Conventional Commits) and the user has
# enabled auto_generate in config.

set -eu

# Bail if claude-rca isn't installed.
command -v claude-rca >/dev/null 2>&1 || exit 0

# Only run if auto_generate is true.
if ! claude-rca config --get auto_generate 2>/dev/null | grep -qx true; then
  exit 0
fi

MSG=$(git log -1 --pretty=%s)
case "$MSG" in
  fix:*|fix\(*\):*)
    # Run in background so commit returns immediately.
    # On failure, write a sentinel file so `claude-rca doctor` and `recent` can warn the user.
    (
      LOG_FILE="$(claude-rca config --get log.file 2>/dev/null || echo /tmp/claude-rca.log)"
      OUTPUT_DIR="$(claude-rca config --get output_dir 2>/dev/null || echo rca)"
      if ! claude-rca generate --from HEAD >"${LOG_FILE}" 2>&1; then
        LAST_LINE="$(tail -1 "${LOG_FILE}")"
        ERROR_MSG="$(node -e "process.stdout.write(JSON.stringify(process.argv[1]))" -- "${LAST_LINE}")"
        TIMESTAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        REF="$(git rev-parse --short HEAD)"
        printf '{"timestamp":"%s","ref":"%s","error":%s}\n' \
          "${TIMESTAMP}" "${REF}" "${ERROR_MSG}" \
          >"${OUTPUT_DIR}/.last-rca-error"
      else
        rm -f "${OUTPUT_DIR}/.last-rca-error"
      fi
    ) &
    disown 2>/dev/null || true
    ;;
  *)
    exit 0
    ;;
esac
